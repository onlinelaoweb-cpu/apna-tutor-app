# ---- Which AI answers the tutor? ----
# gemini = Google Gemini FREE tier (no card, no bill)  <- recommended
# claude = Anthropic API (pay-per-use)
# none   = no AI at all (built-in offline quizzes, worksheets and spelling still work)
# If you leave this blank: gemini if GEMINI_API_KEY is set, else claude if ANTHROPIC_API_KEY is set, else none.
AI_PROVIDER=gemini

# Free key from https://aistudio.google.com/apikey  (sign in with a Google account, press "Create API key")
GEMINI_API_KEY=your_key_here

# Optional: model names to try, in order (names change over time, so they are a setting).
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Only needed if you choose AI_PROVIDER=claude (this one costs money):
# ANTHROPIC_API_KEY=your_key_here

# Safety cap on AI calls per day (default 300). Past it the app uses its offline quizzes until tomorrow.
# DAILY_AI_LIMIT=300

# Optional natural voice (Google Cloud Text-to-Speech). It needs a Google Cloud billing account,
# so for a strictly zero-cost setup leave this EMPTY - the app uses the browser's own voice instead.
GOOGLE_TTS_API_KEY=

# Railway sets PORT automatically - only needed for local testing if you want a custom port
# PORT=3000
